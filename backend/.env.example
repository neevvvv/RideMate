# MongoDB connection string
DB_CONNECT=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>

# Secret key for signing JWTs — use a long random string in production
JWT_SECRET=your_jwt_secret_here

# Geoapify API key — https://www.geoapify.com/
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Port the backend server listens on
PORT=3001

# URL of the deployed frontend (used for CORS and Socket.IO origin)
FRONTEND_URL=http://localhost:5173

# NODE_ENV controls secure cookie flag — set to 'production' on deploy
NODE_ENV=development
